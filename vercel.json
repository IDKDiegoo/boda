{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<pareja>[a-z0-9-]+-y-[a-z0-9-]+)\\.vercel\\.app"
        }
      ],
      "destination": "/inv/:pareja.html"
    },
    {
      "source": "/i/:codigo",
      "destination": "/api/inv?codigo=:codigo"
    },
    {
      "source": "/m/:b",
      "destination": "/api/inv?b=:b"
    },
    {
      "source": "/:slug([a-z0-9-]+-y-[a-z0-9-]+)",
      "destination": "/inv/:slug.html"
    },
    {
      "source": "/:slug([^/]+-[yY]-[^/]+)",
      "destination": "/api/suelta?s=:slug"
    },
    {
      "source": "/:slug([^/]+-[yY]-[^/]+)/",
      "destination": "/api/suelta?s=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
